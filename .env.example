# -----------------------------------------------------------------------------
# TenantForge environment configuration (EXAMPLE)
#
# Copy to `.env` and override for real deployments. The values below are safe,
# non-secret DEV placeholders. Leaving DATABASE_URL / REDIS_URL unset activates
# zero-config demo mode (SQLite + in-process event bus) so the stack runs with
# no PostgreSQL or Redis.
# -----------------------------------------------------------------------------

# --- Security (MUST be overridden in production) ---
# Shared HS256 signing key for JWT session tokens.
SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789
# Shared secret proving an inbound call came from the gateway (service-to-service).
INTERNAL_SECRET=dev-only-internal-service-secret-change-me-01234
# Session length in minutes (default 1440 = 24h).
JWT_EXPIRE_MINUTES=1440

# --- Infrastructure (unset => demo fallbacks) ---
# PostgreSQL via asyncpg. Unset => per-service SQLite file (demo mode).
# DATABASE_URL=postgresql+asyncpg://tenantforge:tenantforge@localhost:5432/identity
# Redis event bus. Unset => in-process in-memory bus (demo mode).
# REDIS_URL=redis://localhost:6379/0

# --- Gateway: downstream service URLs ---
# Defaults target local dev; docker-compose overrides with service DNS names.
IDENTITY_URL=http://localhost:8001
TICKETS_URL=http://localhost:8002
NOTIFICATIONS_URL=http://localhost:8003

# --- Gateway: session cookie hardening ---
# Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Notifications ---
# When true (demo default), "emails" are only logged, never sent.
EMAIL_DEMO_MODE=true

# --- Misc ---
ENVIRONMENT=development
